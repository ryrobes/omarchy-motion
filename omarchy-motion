#!/usr/bin/env bash

set -uo pipefail

PROGRAM_NAME="${0##*/}"
PROGRAM_VERSION="1.2.1"

usage() {
  cat <<EOF
Usage: $PROGRAM_NAME [OPTIONS] SOURCE

Play a local video or web video as a chrome-free Omarchy wallpaper, with audio.
The existing Omarchy theme and static background are not changed.

Arguments:
  SOURCE                  Local media path or an http(s) URL

Options:
  -o, --output OUTPUT     Display to cover (default: ALL; alias: --display)
      --fit MODE          cover or contain (default: cover)
      --cover             Fill the display, cropping as needed
      --contain           Fit the whole video without cropping
  -v, --volume PERCENT    Playback volume, 0-100 (default: 100)
      --audio, --unmute   Enable audio (default)
      --no-audio, --mute  Disable audio
      --dim PERCENT       Overlay opacity, 0-100 (default: 0)
      --dim-color MODE    Dim toward black or theme (default: black)
      --quality HEIGHT    Maximum web-video height; 0 disables cap (default: 1080)
      --transition TYPE   none, fade, omarchy, circle, dissolve, pixelize, or blur
                          (default: fade)
      --transition-duration SECONDS
                          Transition length, greater than 0 and at most 60
                          (default: 0.8)
      --fade-in           Alias for --transition fade
      --no-transition     Disable the startup transition
      --audio-fade        Fade audio in with the transition (default)
      --no-audio-fade     Start audio immediately
      --loop              Loop playback (default)
      --no-loop, --once   Play once instead of looping
      --dry-run           Print the mpvpaper command without starting it
      --version           Show the program version
  -h, --help              Show this help

Examples:
  $PROGRAM_NAME ~/Videos/ambient.mp4
  $PROGRAM_NAME 'https://www.youtube.com/watch?v=VIDEO_ID'
  $PROGRAM_NAME --mute --no-loop video.mp4
  $PROGRAM_NAME --transition omarchy --transition-duration 1.2 video.mp4
  $PROGRAM_NAME --dim 35 --dim-color theme video.mp4
  $PROGRAM_NAME --output DP-1 --fit contain --volume 60 video.mp4

Press Ctrl-C to stop and reveal the existing Omarchy background.
EOF
}

fail() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

is_integer() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

is_transition_duration() {
  local value="$1"
  local whole fraction

  [[ "$value" =~ ^([0-9]+)(\.([0-9]+))?$ ]] || return 1
  whole=$((10#${BASH_REMATCH[1]}))
  fraction="${BASH_REMATCH[3]:-}"

  [[ "$value" =~ [1-9] ]] || return 1
  ((whole < 60)) && return 0
  ((whole == 60)) && [[ -z "$fraction" || ! "$fraction" =~ [1-9] ]]
}

local_media_needs_software_decode() {
  local path="$1"
  local codec=""
  local pixel_format=""
  local key value

  while IFS='=' read -r key value; do
    case "$key" in
      codec_name) codec="$value" ;;
      pix_fmt) pixel_format="$value" ;;
    esac
  done < <(
    ffprobe -v error -select_streams v:0 \
      -show_entries stream=codec_name,pix_fmt \
      -of default=noprint_wrappers=1:nokey=0 \
      -- "$path" 2>/dev/null
  )

  # H.264 hardware decoders are generally limited to 8-bit 4:2:0. Asking mpv
  # to auto-probe them for 4:2:2, 4:4:4, or high-bit-depth input produces a
  # page of errors before its successful software fallback.
  [[ "$codec" == "h264" ]] || return 1
  case "$pixel_format" in
    yuv420p|yuvj420p|nv12) return 1 ;;
    "") return 1 ;;
    *) return 0 ;;
  esac
}

write_transition_cleanup_script() {
  local path="$1"

  (
    umask 077
    set -o noclobber
    cat >"$path" <<'LUA'
local mp = require "mp"

local duration = tonumber(os.getenv("OMARCHY_MOTION_TRANSITION_DURATION")) or 0.8
local final_vf = os.getenv("OMARCHY_MOTION_TRANSITION_FINAL_VF") or ""
local clear_audio_fade = os.getenv("OMARCHY_MOTION_TRANSITION_CLEAR_AF") == "true"
local armed = false
local finished = false

local function finish_transition()
  if finished then return end
  finished = true

  mp.set_property("vf", final_vf)
  if clear_audio_fade then mp.set_property("af", "") end
end

mp.register_event("playback-restart", function()
  if armed or finished then return end
  armed = true
  mp.add_timeout(duration + 0.05, finish_transition)
end)
LUA
  )
}

theme_background_color() {
  local colors_file="${OMARCHY_MOTION_THEME_COLORS:-$HOME/.local/state/omarchy/current/theme/colors.toml}"
  local color

  [[ -r "$colors_file" ]] || fail "could not read the current theme colors: $colors_file"
  color="$(
    sed -nE \
      -e 's/^[[:space:]]*background[[:space:]]*=[[:space:]]*"(#[0-9A-Fa-f]{6})".*$/\1/p' \
      -e "s/^[[:space:]]*background[[:space:]]*=[[:space:]]*'(#[0-9A-Fa-f]{6})'.*$/\\1/p" \
      "$colors_file" | head -n 1
  )"
  [[ "$color" =~ ^#[0-9A-Fa-f]{6}$ ]] || \
    fail "current theme has no valid #RRGGBB background color: $colors_file"

  printf '%s' "$color"
}

output="ALL"
fit_mode="cover"
volume="100"
audio_mode="auto"
dim="0"
dim_color="black"
quality="1080"
transition="fade"
transition_duration="0.8"
audio_fade="true"
loop="true"
dry_run="false"
source_args=()

while (($# > 0)); do
  case "$1" in
    -o|--output|--display)
      (($# >= 2)) || fail "$1 requires a value"
      output="$2"
      shift 2
      ;;
    --fit)
      (($# >= 2)) || fail "$1 requires a value"
      fit_mode="$2"
      shift 2
      ;;
    --cover)
      fit_mode="cover"
      shift
      ;;
    --contain)
      fit_mode="contain"
      shift
      ;;
    -v|--volume)
      (($# >= 2)) || fail "$1 requires a value"
      volume="$2"
      shift 2
      ;;
    --audio|--unmute)
      audio_mode="auto"
      shift
      ;;
    --no-audio|--mute)
      audio_mode="no"
      shift
      ;;
    --dim)
      (($# >= 2)) || fail "$1 requires a value"
      dim="$2"
      shift 2
      ;;
    --dim-color)
      (($# >= 2)) || fail "$1 requires a value"
      dim_color="$2"
      shift 2
      ;;
    --quality)
      (($# >= 2)) || fail "$1 requires a value"
      quality="$2"
      shift 2
      ;;
    --transition)
      (($# >= 2)) || fail "$1 requires a value"
      transition="$2"
      shift 2
      ;;
    --transition-duration)
      (($# >= 2)) || fail "$1 requires a value"
      transition_duration="$2"
      shift 2
      ;;
    --fade-in)
      transition="fade"
      shift
      ;;
    --no-transition)
      transition="none"
      shift
      ;;
    --audio-fade)
      audio_fade="true"
      shift
      ;;
    --no-audio-fade)
      audio_fade="false"
      shift
      ;;
    --loop)
      loop="true"
      shift
      ;;
    --once|--no-loop)
      loop="false"
      shift
      ;;
    --dry-run)
      dry_run="true"
      shift
      ;;
    --version)
      printf '%s %s\n' "$PROGRAM_NAME" "$PROGRAM_VERSION"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while (($# > 0)); do
        source_args+=("$1")
        shift
      done
      break
      ;;
    -*)
      fail "unknown option: $1"
      ;;
    *)
      source_args+=("$1")
      shift
      ;;
  esac
done

((${#source_args[@]} == 1)) || {
  usage >&2
  exit 2
}

source_arg="${source_args[0]}"

case "$fit_mode" in
  cover) panscan="1.0" ;;
  contain) panscan="0.0" ;;
  *) fail "--fit must be 'cover' or 'contain'" ;;
esac

[[ -n "$output" ]] || fail "--output must not be empty"

is_integer "$volume" || fail "--volume must be an integer from 0 to 100"
volume=$((10#$volume))
((volume >= 0 && volume <= 100)) || fail "--volume must be an integer from 0 to 100"

is_integer "$dim" || fail "--dim must be an integer from 0 to 100"
dim=$((10#$dim))
((dim >= 0 && dim <= 100)) || fail "--dim must be an integer from 0 to 100"

case "$dim_color" in
  black|theme) ;;
  *) fail "--dim-color must be 'black' or 'theme'" ;;
esac

is_integer "$quality" || fail "--quality must be a non-negative integer"
quality=$((10#$quality))

case "$transition" in
  none|fade|omarchy|circle|dissolve|pixelize|blur) ;;
  *) fail "--transition must be one of: none, fade, omarchy, circle, dissolve, pixelize, blur" ;;
esac

is_transition_duration "$transition_duration" || \
  fail "--transition-duration must be greater than 0 and at most 60 seconds"

require_command mpvpaper
require_command flock

source_is_web="false"
if [[ "$source_arg" =~ ^https?:// ]]; then
  source="$source_arg"
  source_is_web="true"
  require_command yt-dlp
else
  [[ -f "$source_arg" ]] || fail "local media file not found: $source_arg"
  require_command ffprobe
  source="$(realpath -- "$source_arg")" || fail "could not resolve local media path: $source_arg"
fi

hwdec_mode="auto-safe"
if ((dim > 0)) || [[ "$transition" != "none" ]]; then
  # FFmpeg's drawbox and transition filters need system-memory frames.
  # Copy-back keeps hardware decoding enabled for formats such as YouTube AV1
  # while making those frames available to the filters.
  hwdec_mode="auto-copy-safe"
fi

if [[ "$source_is_web" == "false" ]] && local_media_needs_software_decode "$source"; then
  hwdec_mode="no"
fi

mpv_options=(
  "audio=$audio_mode"
  "hwdec=$hwdec_mode"
  "osc=no"
  "input-default-bindings=no"
  "panscan=$panscan"
  "volume=$volume"
)

dim_filter=""
if ((dim > 0)); then
  if [[ "$dim_color" == "theme" ]]; then
    overlay_color="$(theme_background_color)" || exit $?
    overlay_color="0x${overlay_color#\#}"
  else
    overlay_color="0x000000"
  fi

  if ((dim == 100)); then
    overlay_alpha="1.0"
  else
    printf -v overlay_alpha '0.%02d' "$dim"
  fi
  dim_filter="lavfi=[drawbox=color=${overlay_color}@${overlay_alpha}:t=fill]"
fi

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
transition_script=""
final_vf=""
clear_audio_fade="false"

if [[ "$transition" == "none" ]]; then
  [[ -z "$dim_filter" ]] || mpv_options+=("vf=$dim_filter")
else
  case "$transition" in
    fade) transition_filter="fade" ;;
    omarchy) transition_filter="vertopen" ;;
    circle) transition_filter="circleopen" ;;
    dissolve) transition_filter="dissolve" ;;
    pixelize) transition_filter="pixelize" ;;
    blur) transition_filter="hblur" ;;
  esac

  live_filter="format=rgba"
  if [[ -n "$dim_filter" ]]; then
    live_filter+=",${dim_filter#lavfi=[}"
    live_filter="${live_filter%]}"
    final_vf="$dim_filter"
  fi

  transition_graph="${live_filter},split=2[clear][live];[clear]lutrgb=a=0[transparent];[transparent][live]xfade=transition=${transition_filter}:duration=${transition_duration}:offset=0"
  transition_script="$runtime_dir/omarchy-motion-transition-${UID}-$$-${RANDOM}.lua"
  mpv_options+=(
    "background=none"
    "vf=lavfi=[$transition_graph]"
    "script=$transition_script"
  )

  if [[ "$audio_mode" == "auto" && "$audio_fade" == "true" ]]; then
    mpv_options+=("af=lavfi=[afade=t=in:st=0:d=${transition_duration}]")
    clear_audio_fade="true"
  fi
fi

if [[ "$loop" == "true" ]]; then
  mpv_options+=("loop-file=inf")
fi

if [[ "$source" =~ ^https?:// ]] && ((quality > 0)); then
  mpv_options+=("ytdl-format=bestvideo[height<=${quality}]+bestaudio/best[height<=${quality}]")
fi

printf -v mpv_options_string '%s ' "${mpv_options[@]}"
mpv_options_string="${mpv_options_string% }"

command=(
  mpvpaper
  --layer bottom
  --mpv-options "$mpv_options_string"
  "$output"
  "$source"
)

if [[ "$dry_run" == "true" ]]; then
  printf '%q ' "${command[@]}"
  printf '\n'
  exit 0
fi

[[ -n "${WAYLAND_DISPLAY:-}" ]] || fail "WAYLAND_DISPLAY is not set; run inside the Omarchy desktop session"

lock_file="$runtime_dir/omarchy-motion-${UID}.lock"
exec {lock_fd}>"$lock_file" || fail "could not open runtime lock: $lock_file"
flock -n "$lock_fd" || fail "another omarchy-motion instance is already running"

child_pid=""

cleanup_transition_script() {
  if [[ -n "$transition_script" && -e "$transition_script" ]]; then
    rm -f -- "$transition_script"
  fi
}

cleanup_child() {
  if [[ -n "$child_pid" ]] && kill -0 "$child_pid" 2>/dev/null; then
    kill -TERM "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
}

cleanup() {
  cleanup_child
  cleanup_transition_script
}

if [[ "$transition" != "none" ]]; then
  write_transition_cleanup_script "$transition_script" || {
    cleanup_transition_script
    fail "could not create transition helper: $transition_script"
  }
  export OMARCHY_MOTION_TRANSITION_DURATION="$transition_duration"
  export OMARCHY_MOTION_TRANSITION_FINAL_VF="$final_vf"
  export OMARCHY_MOTION_TRANSITION_CLEAR_AF="$clear_audio_fade"
fi

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

"${command[@]}" &
child_pid=$!
wait "$child_pid"
status=$?
child_pid=""

cleanup_transition_script

trap - INT TERM HUP EXIT
exit "$status"
